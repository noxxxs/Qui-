  - Answer:
    - "\u0431\u0430\u0442\u043E\u043C\u0447\u0438\u043A \u0440\u043E\u0448\u0435\u043D"
    - "\u0432\u0435\u0431\u043A\u0430"
    - "\u043F\u0443\u043B\u044C\u0442"
    - "ssd \u043D\u0430\u043A\u043E\u043F\u0438\u0447\u0443\u0432\u0430\u0447"
    CorrectAnswer: 1
  - Answer:
    - "\u0456\u0433\u0440\u0430\u0448\u043A\u043E\u0432\u0430 \u043C\u0430\u0448\u0438\u043D\u043A\u0430"
    - "\u043C\u0456\u0448\u043E\u043A \u0437 \u043A\u0430\u0440\u0442\u043E\u043F\u043B\u044C\u043E\u0443"
